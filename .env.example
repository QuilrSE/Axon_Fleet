# ─── Service ports & URLs ──────────────────────────────────────────────
GATEWAY_PORT=4000
GATEWAY_URL=http://localhost:4000

AGENT_A_PORT=4001
AGENT_A_PUBLIC_URL=http://localhost:4001

AGENT_B_PORT=4002
AGENT_B_PUBLIC_URL=http://localhost:4002
# Used by Agent A for direct-mode discovery (gateway disabled)
AGENT_B_CARD_URL=http://localhost:4002/.well-known/agent-card.json

DASHBOARD_PORT=5173
# URLs the *browser* uses to reach each service
DASHBOARD_AGENT_A_URL=http://localhost:4001
DASHBOARD_AGENT_B_URL=http://localhost:4002
DASHBOARD_GATEWAY_URL=http://localhost:4000

# ─── Credentials (DEMO VALUES ONLY — never reuse outside this PoC) ─────
# Gateway auth mode: static | oauth2 | oidc | mtls (only "static" is implemented)
AUTH_MODE=static
# Bearer tokens the gateway accepts, mapped to the agent identity they prove
GATEWAY_AGENT_TOKENS=agent-a:poc-gw-token-agent-a,agent-b:poc-gw-token-agent-b
AGENT_A_GATEWAY_TOKEN=poc-gw-token-agent-a
AGENT_B_GATEWAY_TOKEN=poc-gw-token-agent-b
# Credential the gateway presents to agents when it forwards a request
GATEWAY_FORWARD_TOKEN=poc-gw-forward-token
# API keys each agent accepts on its own endpoint in direct mode
AGENT_A_DIRECT_API_KEY=poc-direct-key-agent-a
AGENT_B_DIRECT_API_KEY=poc-direct-key-agent-b

# ─── Additional / third-party gateways ────────────────────────────────
# Gateway profiles are managed at runtime (dashboard "A2A gateways" panel or /api/gateways).
# Credentials in a profile may be literal values or env references like env:AGENT_A_PARTNER_GATEWAY_KEY.
# Gateway URLs may be http:// or https://, on localhost, a private network or the public internet.
# "host:port" without a scheme means http for localhost/private hosts and https for public hosts.
# Restrict which hosts a gateway URL may point to (comma-separated hostnames; empty = any):
GATEWAY_URL_ALLOWLIST=
# Allow gateways on localhost / private networks (LAN, VPN, Docker, Kubernetes)
GATEWAY_ALLOW_PRIVATE_NETWORKS=true
# Reject plain http:// for gateways on public hosts (private/localhost http stays allowed)
GATEWAY_REQUIRE_HTTPS_FOR_PUBLIC=false
# Outbound proxy for public gateways; hosts in NO_PROXY are reached directly
# HTTPS_PROXY=http://proxy.corp.example:3128
# NO_PROXY=localhost,127.0.0.1,.corp.example
# Trust a private CA for https gateways inside your network
# NODE_EXTRA_CA_CERTS=/path/to/corp-ca.pem
# Mock third-party gateway ("Partner A2A Exchange") — demo values only
PARTNER_GATEWAY_PORT=4100
PARTNER_GATEWAY_API_KEYS=agent-a:partner-key-agent-a,agent-b:partner-key-agent-b
PARTNER_GATEWAY_FORWARD_TOKEN=partner-forward-token
AGENT_A_PARTNER_GATEWAY_KEY=partner-key-agent-a
AGENT_B_PARTNER_GATEWAY_KEY=partner-key-agent-b

# ─── Bifrost Agent Gateway (see docs/bifrost.md) ──────────────────────
# Virtual key the agents use to call through Bifrost (x-bf-vk)
BIFROST_VIRTUAL_KEY=
# Token Bifrost sends to the agents (set the same value as the registration's
# request header "Authorization: Bearer <token>")
BIFROST_FORWARD_TOKEN=bifrost-forward-token
# Optional: lets the agents register themselves via POST /api/agents (see docs/bifrost.md).
# Pick the one that matches your Bifrost and select it as "Management auth" on the gateway:
#   OSS with dashboard login (default template):  admin username:password
BIFROST_ADMIN_CREDENTIALS=
#   Enterprise: management API key with AgentGateway:Create, :Update, :View scopes
BIFROST_MANAGEMENT_KEY=
#   OSS without dashboard login only (cannot register private addresses such as host.docker.internal)
BIFROST_SETUP_TOKEN=

# Agent Card format: dual (A2A v1.0 + v0.3 compatibility fields) | v1 (strict A2A v1.0)
AGENT_CARD_FORMAT=dual

# Allow "Reveal secrets" in the dashboard's Equivalent curl view (local dev convenience)
DASHBOARD_ALLOW_SECRET_REVEAL=true

# ─── Gateway policy ────────────────────────────────────────────────────
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=10000
HEALTH_CHECK_INTERVAL_MS=5000

# ─── Agent behaviour ───────────────────────────────────────────────────
GATEWAY_DEFAULT_ENABLED=true
AGENT_B_STEP_DELAY_MS=900
TELEMETRY_SEED=42
REGISTRATION_INTERVAL_MS=15000
RUNTIME_DIR=.runtime

# ─── Misc ──────────────────────────────────────────────────────────────
CORS_ORIGINS=*
LOG_LEVEL=info
